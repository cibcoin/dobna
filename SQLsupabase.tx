-- ============================================
-- 10. قوانین امنیتی (RLS)
-- ============================================

-- فعال‌سازی RLS در همه جداول
alter table public.profiles enable row level security;
alter table public.user_accounts enable row level security;
alter table public.transactions enable row level security;
alter table public.groups enable row level security;
alter table public.group_members enable row level security;
alter table public.group_games enable row level security;
alter table public.game_cards enable row level security;
alter table public.group_chat_messages enable row level security;
alter table public.private_messages enable row level security;
alter table public.support_tickets enable row level security;
alter table public.reports enable row level security;

-- سیاست‌های دسترسی (نمونه)
create policy "Users can view own profile"
    on public.profiles for select using (auth.uid() = id);

create policy "Users can update own profile"
    on public.profiles for update using (auth.uid() = id);

create policy "Users can view their own transactions"
    on public.transactions for select using (auth.uid() = user_id);

create policy "Members can view group messages"
    on public.group_chat_messages for select using (
        exists (select 1 from public.group_members where group_members.group_id = group_chat_messages.group_id and group_members.user_id = auth.uid())
    );

-- ============================================
-- 11. توابع کمکی
-- ============================================

-- تابع تولید شماره حساب 10 رقمی یکتا
create or replace function generate_dobna_id()
returns text
language plpgsql
as $$
declare
    new_id text;
    exists_id boolean;
begin
    loop
        new_id := floor(random() * 9000000000 + 1000000000)::text;
        select exists(select 1 from public.profiles where dobna_id = new_id) into exists_id;
        exit when not exists_id;
    end loop;
    return new_id;
end;
$$;

-- تابع ایجاد خودکار پروفایل
create or replace function public.handle_new_user()
returns trigger
language plpgsql
security definer set search_path = public
as $$
declare
    new_dobna_id text;
    new_username text;
begin
    -- تولید شماره دوبنا
    new_dobna_id := generate_dobna_id();
    
    -- تولید نام کاربری پیش‌فرض
    new_username := coalesce(new.raw_user_meta_data->>'username', 'user_' || substr(md5(random()::text), 1, 8));
    
    -- ایجاد پروفایل
    insert into public.profiles (
        id, phone, email, username, display_name, dobna_id
    ) values (
        new.id,
        new.phone,
        new.email,
        new_username,
        coalesce(new.raw_user_meta_data->>'full_name', new_username),
        new_dobna_id
    );
    
    -- ایجاد حساب کاربری
    insert into public.user_accounts (user_id, account_number)
    values (new.id, new_dobna_id);
    
    return new;
end;
$$;

-- تریگر برای ایجاد خودکار پروفایل
create trigger on_auth_user_created
    after insert on auth.users
    for each row execute function public.handle_new_user();




-- ============================================
-- جداول مدیریت کارت به کارت
-- ============================================

-- 1. تنظیمات حساب بانکی دوبنا
create table public.bank_account_settings (
    id integer primary key default 1,
    card_number text not null,                  -- شماره کارت بانکی دوبنا
    bank_name text not null,                    -- نام بانک
    account_holder text not null,               -- نام صاحب حساب
    shaba_number text,                          -- شماره شبا
    is_active boolean default true,
    updated_at timestamp with time zone default now()
);

-- 2. درخواست‌های شارژ کارت به کارت
create table public.card_to_card_requests (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    amount bigint not null,
    reference_code text unique,                 -- کد پیگیری یکتا (برای کاربر)
    status text default 'pending' check (status in ('pending', 'paid', 'cancelled', 'failed')),
    
    -- اطلاعات واریز (توسط کاربر وارد می‌شود - اختیاری)
    transaction_id text,                        -- شماره پیگیری بانکی کاربر
    receipt_image text,                         -- تصویر رسید (اختیاری)
    
    -- اطلاعات تأیید (توسط ادمین)
    admin_note text,
    verified_by uuid references public.profiles(id),
    verified_at timestamp with time zone,
    
    created_at timestamp with time zone default now()
);

-- 3. لاگ واریزهای کارت به کارت (برای تسویه حساب)
create table public.card_to_card_logs (
    id uuid default uuid_generate_v4() primary key,
    request_id uuid references public.card_to_card_requests(id),
    user_id uuid references public.profiles(id),
    amount bigint not null,
    bank_transaction_id text,                   -- شماره پیگیری بانک
    card_number_used text,                      -- 4 رقم آخر کارت واریزکننده
    admin_id uuid references public.profiles(id),
    verified_at timestamp with time zone default now()
);

-- 1. اضافه کردن فیلدهای رمز ارز به جدول تراکنش‌ها (Transactions)
ALTER TABLE public.transactions
ADD COLUMN crypto_currency text,      -- 'USDT', 'SOL'
ADD COLUMN crypto_amount numeric,     -- مقدار رمز ارز
ADD COLUMN exchange_rate numeric;     -- نرخ تبدیل در لحظه واریز

-- 2. جدول آدرس‌های واریز موقت (برای امنیت بیشتر)
CREATE TABLE public.crypto_deposit_addresses (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    user_id uuid REFERENCES public.profiles(id),
    transaction_id uuid REFERENCES public.transactions(id),
    address text NOT NULL,              -- آدرس واریز یکتا
    currency text NOT NULL,
    expected_amount numeric,            -- مبلغ دقیق مورد انتظار
    status text DEFAULT 'waiting',      -- waiting, confirmed, expired
    expires_at timestamptz,
    created_at timestamptz DEFAULT now()
);

-- ============================================
-- جداول مدیریت رمز ارز
-- ============================================

-- 1. تنظیمات کیف پول‌های دوبنا
create table public.crypto_wallet_settings (
    id integer primary key default 1,
    -- کیف پول USDT (TRC20)
    usdt_address text not null,
    usdt_network text default 'TRC20',
    -- کیف پول Solana
    solana_address text not null,
    solana_network text default 'Solana',
    -- تنظیمات کلی
    is_active boolean default true,
    updated_at timestamp with time zone default now()
);

-- 2. درخواست‌های واریز رمز ارز
create table public.crypto_deposit_requests (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    currency text not null check (currency in ('USDT', 'SOL')),
    amount_crypto numeric,                    -- مقدار رمز ارز (پس از واریز پر می‌شود)
    amount_toman numeric,                     -- معادل تومانی
    exchange_rate numeric,                    -- نرخ تبدیل لحظه‌ای
    wallet_address text not null,             -- آدرس واریز اختصاصی
    transaction_hash text,                    -- هش تراکنش در بلاکچین
    status text default 'pending' check (status in ('pending', 'confirmed', 'completed', 'expired', 'failed')),
    confirmed_at timestamp with time zone,
    completed_at timestamp with time zone,
    expires_at timestamp with time zone,      -- انقضای آدرس واریز
    created_at timestamp with time zone default now()
);

-- 3. درخواست‌های برداشت رمز ارز
create table public.crypto_withdraw_requests (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    currency text not null check (currency in ('USDT', 'SOL')),
    amount_crypto numeric not null,
    amount_toman numeric not null,
    exchange_rate numeric not null,
    destination_address text not null,        -- آدرس کیف پول کاربر
    transaction_hash text,                    -- هش تراکنش خروجی
    status text default 'pending' check (status in ('pending', 'processing', 'completed', 'rejected')),
    admin_note text,
    processed_by uuid references public.profiles(id),
    created_at timestamp with time zone default now(),
    processed_at timestamp with time zone
);

-- 4. نرخ‌های لحظه‌ای ارزها (برای محاسبات)
create table public.exchange_rates (
    id uuid default uuid_generate_v4() primary key,
    currency text not null check (currency in ('USDT', 'SOL')),
    rate_to_toman numeric not null,           -- نرخ تبدیل به تومان
    spread_percent numeric default 1,          -- اسپرد (1% = کارمزد پنهان)
    effective_rate numeric,                   -- نرخ مؤثر پس از اسپرد
    source text,
    fetched_at timestamp with time zone default now()
);