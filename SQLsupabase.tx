-- ============================================
-- پایان اسکریپت
-- ============================================

-- ============================================
-- ادامه اسکریپت قبلی - بخش اتاق‌های پویا و صف‌بندی
-- ============================================

-- 1. جدول سطوح اتاق‌ها (Room Tiers)
create table public.room_tiers (
    id integer primary key,
    name text not null,  -- مثلاً "۵,۰۰۰ تومانی"
    card_price integer not null,  -- قیمت هر کارت
    entry_fee integer not null,  -- هزینه ورود (همان card_price * 3)
    total_cards integer default 30,
    line_prize_percentage numeric default 9,  -- ۹٪
    full_house_prize_percentage numeric default 81,  -- ۸۱٪
    platform_fee_percentage numeric default 10,  -- ۱۰٪
    is_active boolean default true
);

-- 2. جدول اتاق‌های فعال (با پشتیبانی از چندین اتاق همزمان)
create table public.active_rooms (
    id uuid default uuid_generate_v4() primary key,
    tier_id integer references public.room_tiers(id),
    room_number integer not null,  -- شماره اتاق (۱، ۲، ۳، ...)
    status text default 'waiting' check (status in ('waiting', 'active', 'full', 'finished')),
    current_players integer default 0,
    current_cards integer default 0,  -- کارت‌های فروخته شده
    max_cards integer default 30,
    created_at timestamp with time zone default now(),
    started_at timestamp with time zone,
    finished_at timestamp with time zone,
    unique(tier_id, room_number)
);

-- 3. جدول صف انتظار (Queue System)
create table public.waiting_queue (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id),
    tier_id integer references public.room_tiers(id),
    desired_cards integer default 3,  -- ۱ تا ۳ کارت
    joined_at timestamp with time zone default now(),
    status text default 'waiting' check (status in ('waiting', 'matched', 'cancelled')),
    matched_room_id uuid references public.active_rooms(id)
);

-- 4. جدول بازی‌های در حال انجام
create table public.active_games (
    id uuid default uuid_generate_v4() primary key,
    room_id uuid references public.active_rooms(id),
    status text default 'active' check (status in ('active', 'finished', 'cancelled')),
    called_numbers integer[] default '{}',
    current_turn integer default 0,
    winner_line uuid[],  -- آرایه‌ای از برندگان خطی
    winner_full uuid[],   -- آرایه‌ای از برندگان پر
    line_prize_amount integer,
    full_house_prize_amount integer,
    started_at timestamp with time zone default now(),
    finished_at timestamp with time zone
);

-- 5. جدول کارت‌های هر بازی
create table public.game_cards_extended (
    id uuid default uuid_generate_v4() primary key,
    game_id uuid references public.active_games(id),
    user_id uuid references public.profiles(id),
    card_number integer,  -- شماره کارت (۱ تا ۳۰ در هر اتاق)
    card_data integer[][],  -- آرایه ۳×۹
    marked_numbers integer[] default '{}',
    line_completed boolean[] default '{false, false, false}',  -- ردیف ۱،۲،۳
    is_winner_line boolean default false,
    is_winner_full boolean default false,
    created_at timestamp with time zone default now()
);

-- ============================================
-- 6. تابع ایجاد خودکار اتاق جدید
-- ============================================

create or replace function create_new_room_if_needed(
    p_tier_id integer
)
returns uuid
language plpgsql
as $$
declare
    v_last_room_number integer;
    v_new_room_id uuid;
    v_waiting_count integer;
begin
    -- پیدا کردن آخرین شماره اتاق برای این tier
    select coalesce(max(room_number), 0) into v_last_room_number
    from public.active_rooms
    where tier_id = p_tier_id and status in ('waiting', 'active');
    
    -- بررسی آیا اتاق waiting با ظرفیت خالی وجود دارد
    select id into v_new_room_id
    from public.active_rooms
    where tier_id = p_tier_id 
      and status = 'waiting' 
      and current_cards < max_cards
    limit 1;
    
    -- اگر نبود، اتاق جدید بساز
    if v_new_room_id is null then
        insert into public.active_rooms (tier_id, room_number, status, max_cards)
        values (p_tier_id, v_last_room_number + 1, 'waiting', 30)
        returning id into v_new_room_id;
    end if;
    
    return v_new_room_id;
end;
$$;

-- ============================================
-- 7. تابع اضافه کردن کاربر به اتاق (با صف‌بندی هوشمند)
-- ============================================

create or replace function add_user_to_room(
    p_user_id uuid,
    p_tier_id integer,
    p_cards_count integer
)
returns json
language plpgsql
as $$
declare
    v_target_room_id uuid;
    v_result json;
    v_available_cards integer;
    v_balance bigint;
    v_total_cost integer;
    v_tier_record record;
begin
    -- دریافت اطلاعات tier
    select * into v_tier_record from public.room_tiers where id = p_tier_id;
    
    -- محاسبه هزینه کل
    v_total_cost := v_tier_record.card_price * p_cards_count;
    
    -- بررسی موجودی کاربر
    select balance into v_balance from public.profiles where id = p_user_id;
    
    if v_balance < v_total_cost then
        return json_build_object('success', false, 'error', 'insufficient_balance');
    end if;
    
    -- پیدا کردن یا ایجاد اتاق مناسب
    select create_new_room_if_needed(p_tier_id) into v_target_room_id;
    
    -- بررسی ظرفیت اتاق
    select (max_cards - current_cards) into v_available_cards
    from public.active_rooms
    where id = v_target_room_id;
    
    if v_available_cards >= p_cards_count then
        -- کاربر مستقیماً加入 اتاق می‌شود
        update public.active_rooms 
        set current_cards = current_cards + p_cards_count,
            current_players = current_players + 1
        where id = v_target_room_id;
        
        -- کسر موجودی
        update public.profiles 
        set balance = balance - v_total_cost
        where id = p_user_id;
        
        -- ثبت تراکنش
        insert into public.transactions (user_id, type, amount, status)
        values (p_user_id, 'entry_fee', v_total_cost, 'completed');
        
        v_result := json_build_object(
            'success', true, 
            'room_id', v_target_room_id,
            'action', 'joined'
        );
    else
        -- کاربر به صف انتظار می‌رود
        insert into public.waiting_queue (user_id, tier_id, desired_cards, status)
        values (p_user_id, p_tier_id, p_cards_count, 'waiting');
        
        v_result := json_build_object(
            'success', true, 
            'queue_position', (select count(*) from public.waiting_queue where tier_id = p_tier_id and status = 'waiting'),
            'action', 'queued'
        );
    end if;
    
    return v_result;
end;
$$;

-- ============================================
-- 8. تابع شروع خودکار بازی (برای اجرای دوره‌ای)
-- ============================================

create or replace function auto_start_room()
returns trigger
language plpgsql
as $$
declare
    v_game_id uuid;
    v_prize_line integer;
    v_prize_full integer;
    v_tier_record record;
begin
    -- وقتی کارت‌های اتاق به ۳۰ رسید، بازی شروع شود
    if NEW.current_cards >= NEW.max_cards and OLD.current_cards < NEW.max_cards then
        -- دریافت اطلاعات جایزه‌ها
        select * into v_tier_record 
        from public.room_tiers 
        where id = NEW.tier_id;
        
        -- محاسبه مبالغ جایزه
        v_prize_line := (NEW.current_cards * v_tier_record.card_price * v_tier_record.line_prize_percentage) / 100;
        v_prize_full := (NEW.current_cards * v_tier_record.card_price * v_tier_record.full_house_prize_percentage) / 100;
        
        -- ایجاد بازی جدید
        insert into public.active_games (
            room_id, 
            line_prize_amount, 
            full_house_prize_amount
        ) values (
            NEW.id,
            v_prize_line,
            v_prize_full
        ) returning id into v_game_id;
        
        -- بروزرسانی وضعیت اتاق
        update public.active_rooms 
        set status = 'active', started_at = now()
        where id = NEW.id;
        
        -- اینجا می‌توانید تابع تولید کارت‌های تصادفی را صدا بزنید
    end if;
    
    return NEW;
end;
$$;

-- تریگر برای شروع خودکار بازی
create trigger trigger_auto_start_room
    after update on public.active_rooms
    for each row
    execute function auto_start_room();

-- ============================================
-- 9. تابع تولید کارت تصادفی Bingo (۳×۹)
-- ============================================

create or replace function generate_bingo_card()
returns integer[][]
language plpgsql
as $$
declare
    card integer[3][9];
    col_numbers integer[];
    col integer;
    row integer;
    numbers_pool integer[];
    selected_numbers integer[];
begin
    -- برای هر ستون (۱ تا ۹)، محدوده اعداد مشخص است
    for col in 1..9 loop
        -- تعیین محدوده اعداد برای هر ستون
        case col
            when 1 then col_numbers := array(select generate_series(1, 9));
            when 2 then col_numbers := array(select generate_series(10, 19));
            when 3 then col_numbers := array(select generate_series(20, 29));
            when 4 then col_numbers := array(select generate_series(30, 39));
            when 5 then col_numbers := array(select generate_series(40, 49));
            when 6 then col_numbers := array(select generate_series(50, 59));
            when 7 then col_numbers := array(select generate_series(60, 69));
            when 8 then col_numbers := array(select generate_series(70, 79));
            when 9 then col_numbers := array(select generate_series(80, 90));
        end case;
        
        -- انتخاب ۲ یا ۳ عدد تصادفی برای این ستون
        -- (در هر ستون باید ۲ عدد خالی و ۱ عدد پر داشته باشیم)
        -- اینجا ساده شده، در پیاده‌سازی واقعی باید دقیق‌تر شود
        for row in 1..3 loop
            if random() > 0.33 then  -- ۶۶٪ شانس پر بودن
                card[row][col] := col_numbers[1 + floor(random() * array_length(col_numbers, 1))];
            else
                card[row][col] := 0;  -- 0 نشان‌دهنده خالی
            end if;
        end loop;
    end loop;
    
    return card;
end;
$$;

-- ============================================
-- 10. درج سطوح اتاق‌ها (Tiers)
-- ============================================

insert into public.room_tiers (id, name, card_price, entry_fee, total_cards, line_prize_percentage, full_house_prize_percentage, platform_fee_percentage) values
(1, '۵,۰۰۰ تومانی', 5000, 15000, 30, 9, 81, 10),
(2, '۱۰,۰۰۰ تومانی', 10000, 30000, 30, 9, 81, 10),
(3, '۲۰,۰۰۰ تومانی', 20000, 60000, 30, 9, 81, 10),
(4, '۵۰,۰۰۰ تومانی', 50000, 150000, 30, 9, 81, 10),
(5, '۱۰۰,۰۰۰ تومانی', 100000, 300000, 30, 9, 81, 10);

-- ============================================
-- 11. ایندکس‌های اضافی برای عملکرد بهتر
-- ============================================

create index idx_active_rooms_status on public.active_rooms(status, tier_id);
create index idx_waiting_queue_tier on public.waiting_queue(tier_id, status);
create index idx_active_games_room on public.active_games(room_id, status);
create index idx_game_cards_game on public.game_cards_extended(game_id, user_id);

-- ============================================
-- جداول سیستم داور
-- ============================================

-- 1. جدول تاریخچه برندگان
create table public.winners_history (
    id uuid default uuid_generate_v4() primary key,
    game_id uuid references public.active_games(id),
    room_id uuid references public.active_rooms(id),
    winner_type text not null check (winner_type in ('line', 'full_house')),
    winner_user_id uuid references public.profiles(id),
    winner_user_name text not null,
    card_number integer not null,  -- شماره کارت برنده (1 تا 30)
    line_index integer,  -- اگر برنده خطی است، کدام ردیف (0,1,2)
    prize_amount bigint not null,
    is_shared boolean default false,  -- آیا جایزه تقسیم شده؟
    shared_with integer default 1,    -- تعداد برندگان همزمان
    created_at timestamp with time zone default now()
);

-- 2. جدول تسویه‌های لحظه‌ای (برای جلوگیری از پرداخت دوبل)
create table public.prize_payments (
    id uuid default uuid_generate_v4() primary key,
    game_id uuid references public.active_games(id),
    winner_id uuid references public.profiles(id),
    winner_type text check (winner_type in ('line', 'full_house')),
    amount bigint not null,
    status text default 'pending' check (status in ('pending', 'paid', 'failed')),
    paid_at timestamp with time zone,
    transaction_id uuid references public.transactions(id),
    created_at timestamp with time zone default now()
);

-- 3. افزودن ستون‌های جدید به active_games
alter table public.active_games add column if not exists line_winner_declared boolean default false;
alter table public.active_games add column if not exists full_house_winner_declared boolean default false;
alter table public.active_games add column if not exists line_winner_id uuid;
alter table public.active_games add column if not exists full_house_winner_id uuid;
alter table public.active_games add column if not exists line_prize_paid boolean default false;
alter table public.active_games add column if not exists full_house_prize_paid boolean default false;
-- ============================================
-- تابع اصلی داور: بررسی و اعلام برنده
-- ============================================

create or replace function judge_check_winner(
    p_game_id uuid,
    p_number_called integer
)
returns json
language plpgsql
as $$
declare
    v_result json;
    v_line_winners json[];
    v_full_house_winners json[];
    v_game_record record;
    v_room_record record;
    v_tier_record record;
    v_line_prize bigint;
    v_full_house_prize bigint;
    v_winner_count integer;
    v_shared_prize bigint;
begin
    -- گرفتن اطلاعات بازی
    select * into v_game_record 
    from public.active_games 
    where id = p_game_id and status = 'active';
    
    if not found then
        return json_build_object('success', false, 'error', 'Game not found or not active');
    end if;
    
    -- گرفتن اطلاعات اتاق
    select * into v_room_record 
    from public.active_rooms 
    where id = v_game_record.room_id;
    
    -- گرفتن اطلاعات tier (برای محاسبه جایزه)
    select * into v_tier_record 
    from public.room_tiers 
    where id = v_room_record.tier_id;
    
    -- محاسبه جایزه کل
    v_line_prize := (v_room_record.current_cards * v_tier_record.card_price * v_tier_record.line_prize_percentage) / 100;
    v_full_house_prize := (v_room_record.current_cards * v_tier_record.card_price * v_tier_record.full_house_prize_percentage) / 100;
    
    -- ========================================
    -- 1. بررسی برندگان خطی (اگر قبلاً اعلام نشده)
    -- ========================================
    if not v_game_record.line_winner_declared then
        -- پیدا کردن همه کارت‌هایی که یک ردیف کامل دارند
        select array_agg(json_build_object(
            'user_id', gc.user_id,
            'user_name', p.username,
            'card_number', gc.card_number,
            'line_index', line_idx.line_index
        )) into v_line_winners
        from public.game_cards_extended gc
        join public.profiles p on p.id = gc.user_id
        cross join lateral unnest(gc.line_completed) with ordinality as line_idx(completed, line_index)
        where gc.game_id = p_game_id
          and gc.line_completed[line_idx.line_index] = true
          and not gc.is_winner_line;
        
        if array_length(v_line_winners, 1) > 0 then
            -- چند برنده همزمان خطی
            v_winner_count := array_length(v_line_winners, 1);
            v_shared_prize := v_line_prize / v_winner_count;
            
            -- ثبت هر برنده خطی
            for i in 1..v_winner_count loop
                -- ثبت در تاریخچه
                insert into public.winners_history (
                    game_id, room_id, winner_type, winner_user_id, winner_user_name,
                    card_number, line_index, prize_amount, is_shared, shared_with
                ) values (
                    p_game_id, v_room_record.id, 'line',
                    (v_line_winners[i]->>'user_id')::uuid,
                    v_line_winners[i]->>'user_name',
                    (v_line_winners[i]->>'card_number')::integer,
                    (v_line_winners[i]->>'line_index')::integer,
                    v_shared_prize,
                    true, v_winner_count
                );
                
                -- ثبت در جدول پرداخت
                insert into public.prize_payments (
                    game_id, winner_id, winner_type, amount, status
                ) values (
                    p_game_id, (v_line_winners[i]->>'user_id')::uuid, 'line', v_shared_prize, 'pending'
                );
                
                -- آپدیت کارت به عنوان برنده خطی
                update public.game_cards_extended
                set is_winner_line = true
                where game_id = p_game_id 
                  and user_id = (v_line_winners[i]->>'user_id')::uuid
                  and card_number = (v_line_winners[i]->>'card_number')::integer;
            end loop;
            
            -- آپدیت بازی: برنده خطی اعلام شد
            update public.active_games 
            set line_winner_declared = true
            where id = p_game_id;
            
            v_result := json_build_object(
                'success', true,
                'winner_type', 'line',
                'winner_count', v_winner_count,
                'each_prize', v_shared_prize,
                'winners', v_line_winners
            );
            
            return v_result;
        end if;
    end if;
    
    -- ========================================
    -- 2. بررسی برندگان پر (اگر قبلاً اعلام نشده)
    -- ========================================
    if not v_game_record.full_house_winner_declared then
        -- پیدا کردن کارت‌هایی که همه اعدادشان علامت خورده
        select array_agg(json_build_object(
            'user_id', gc.user_id,
            'user_name', p.username,
            'card_number', gc.card_number
        )) into v_full_house_winners
        from public.game_cards_extended gc
        join public.profiles p on p.id = gc.user_id
        where gc.game_id = p_game_id
          and array_length(gc.marked_numbers, 1) >= 15  -- کارت 15 عدد دارد
          and not gc.is_winner_full;
        
        if array_length(v_full_house_winners, 1) > 0 then
            -- چند برنده همزمان پر
            v_winner_count := array_length(v_full_house_winners, 1);
            v_shared_prize := v_full_house_prize / v_winner_count;
            
            -- ثبت هر برنده پر
            for i in 1..v_winner_count loop
                -- ثبت در تاریخچه
                insert into public.winners_history (
                    game_id, room_id, winner_type, winner_user_id, winner_user_name,
                    card_number, prize_amount, is_shared, shared_with
                ) values (
                    p_game_id, v_room_record.id, 'full_house',
                    (v_full_house_winners[i]->>'user_id')::uuid,
                    v_full_house_winners[i]->>'user_name',
                    (v_full_house_winners[i]->>'card_number')::integer,
                    v_shared_prize,
                    true, v_winner_count
                );
                
                -- ثبت در جدول پرداخت
                insert into public.prize_payments (
                    game_id, winner_id, winner_type, amount, status
                ) values (
                    p_game_id, (v_full_house_winners[i]->>'user_id')::uuid, 'full_house', v_shared_prize, 'pending'
                );
                
                -- آپدیت کارت به عنوان برنده پر
                update public.game_cards_extended
                set is_winner_full = true
                where game_id = p_game_id 
                  and user_id = (v_full_house_winners[i]->>'user_id')::uuid
                  and card_number = (v_full_house_winners[i]->>'card_number')::integer;
            end loop;
            
            -- آپدیت بازی: برنده پر اعلام شد و بازی تمام شد
            update public.active_games 
            set full_house_winner_declared = true,
                status = 'finished',
                finished_at = now()
            where id = p_game_id;
            
            -- آپدیت اتاق به finished
            update public.active_rooms 
            set status = 'finished', finished_at = now()
            where id = v_room_record.id;
            
            v_result := json_build_object(
                'success', true,
                'winner_type', 'full_house',
                'winner_count', v_winner_count,
                'each_prize', v_shared_prize,
                'winners', v_full_house_winners
            );
            
            return v_result;
        end if;
    end if;
    
    -- هیچ برنده‌ای یافت نشد
    return json_build_object('success', false, 'message', 'No winner yet');
end;
$$;

-- ============================================
-- تابع تسویه حساب خودکار به حساب کاربران
-- ============================================

create or replace function auto_settle_prizes(
    p_game_id uuid
)
returns json
language plpgsql
as $$
declare
    v_payment record;
    v_balance_updated bigint;
    v_transaction_id uuid;
    v_result json;
begin
    -- پرداخت همه جایزه‌های pending این بازی
    for v_payment in 
        select * from public.prize_payments 
        where game_id = p_game_id and status = 'pending'
    loop
        -- ثبت تراکنش
        insert into public.transactions (
            user_id, type, amount, status, reference
        ) values (
            v_payment.winner_id,
            'win',
            v_payment.amount,
            'completed',
            p_game_id::text
        ) returning id into v_transaction_id;
        
        -- افزایش موجودی کاربر
        update public.profiles
        set balance = balance + v_payment.amount
        where id = v_payment.winner_id
        returning balance into v_balance_updated;
        
        -- آپدیت وضعیت پرداخت
        update public.prize_payments
        set status = 'paid',
            paid_at = now(),
            transaction_id = v_transaction_id
        where id = v_payment.id;
        
        -- ثبت در لاگ
        raise notice 'پرداخت % تومان به کاربر % انجام شد', v_payment.amount, v_payment.winner_id;
    end loop;
    
    -- جمع‌آوری آمار پرداخت
    select json_agg(row_to_json(t)) into v_result
    from (
        select winner_id, winner_type, amount, status, paid_at
        from public.prize_payments
        where game_id = p_game_id and status = 'paid'
    ) t;
    
    return json_build_object(
        'success', true,
        'payments', coalesce(v_result, '[]'::json),
        'message', 'All prizes settled'
    );
end;
$$;

-- ============================================
-- جداول مدیریت مالی (تکمیل کننده جداول قبل)
-- ============================================

-- 1. جدول تراکنش‌های مالی (اصلی)
create table public.transactions (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    type text not null check (type in (
        'deposit',           -- واریز از طریق درگاه
        'withdraw',          -- برداشت به حساب بانکی
        'transfer_out',      -- انتقال به کاربر دیگر (کاهش)
        'transfer_in',       -- دریافت از کاربر دیگر (افزایش)
        'game_entry',        -- ورود به بازی (کاهش)
        'game_win_line',     -- برد خطی
        'game_win_full',     -- برد پر
        'commission'         -- کمیسیون دریافتی
    )),
    amount bigint not null,  -- مبلغ به تومان
    balance_after bigint not null,  -- موجودی بعد از تراکنش
    status text default 'pending' check (status in ('pending', 'completed', 'failed', 'cancelled')),
    
    -- فیلدهای مرتبط با تراکنش
    reference_id text,        -- شماره پیگیری/ارجاع
    from_user_id uuid references public.profiles(id),  -- برای انتقال داخلی
    to_user_id uuid references public.profiles(id),    -- برای انتقال داخلی
    
    -- فیلدهای مرتبط با بازی
    game_id uuid references public.active_games(id),
    room_id uuid references public.active_rooms(id),
    
    -- فیلدهای مرتبط با درگاه
    payment_authority text,   -- کد Authority زرین‌پال
    payment_ref_id text,      -- RefID زرین‌پال
    
    -- متادیتا
    description text,
    metadata jsonb,
    created_at timestamp with time zone default now(),
    completed_at timestamp with time zone
);

-- 2. جدول محدودیت‌های روزانه انتقال
create table public.daily_transfer_limits (
    user_id uuid references public.profiles(id) primary key,
    transferred_today bigint default 0,  -- مبلغ انتقال داده شده امروز
    last_reset_date date default current_date,
    updated_at timestamp with time zone default now()
);

-- 3. جدول درخواست‌های برداشت
create table public.withdraw_requests (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    amount bigint not null,
    bank_name text not null,
    card_number text not null,
    account_holder text not null,  -- نام صاحب حساب
    iban text,  -- شبا (اختیاری)
    status text default 'pending' check (status in ('pending', 'processing', 'completed', 'rejected')),
    admin_note text,
    transaction_id uuid references public.transactions(id),
    created_at timestamp with time zone default now(),
    processed_at timestamp with time zone,
    processed_by uuid references auth.users
);

-- 4. جدول لاگ انتقال‌های داخلی (برای پیگیری)
create table public.internal_transfers_log (
    id uuid default uuid_generate_v4() primary key,
    from_user_id uuid references public.profiles(id),
    to_user_id uuid references public.profiles(id),
    amount bigint not null,
    from_balance_before bigint,
    from_balance_after bigint,
    to_balance_before bigint,
    to_balance_after bigint,
    description text,
    created_at timestamp with time zone default now()
);

-- 5. جدول تنظیمات سیستم
create table public.system_settings (
    key text primary key,
    value jsonb,
    updated_at timestamp with time zone default now()
);

-- درج تنظیمات اولیه
insert into public.system_settings (key, value) values
('transfer_limits', '{"min_amount": 10000, "max_amount": 1000000, "daily_limit": 10000000}'::jsonb),
('game_commission', '{"platform_percent": 10, "line_percent": 9, "full_percent": 81}'::jsonb);

-- ============================================
-- ایندکس‌ها برای بهبود عملکرد
-- ============================================

create index idx_transactions_user_id on public.transactions(user_id);
create index idx_transactions_created_at on public.transactions(created_at);
create index idx_transactions_status on public.transactions(status);
create index idx_transactions_type on public.transactions(type);
create index idx_withdraw_requests_user_id on public.withdraw_requests(user_id);
create index idx_withdraw_requests_status on public.withdraw_requests(status);
create index idx_internal_transfers_log_from on public.internal_transfers_log(from_user_id);
create index idx_internal_transfers_log_to on public.internal_transfers_log(to_user_id);

-- ============================================
-- توابع کمکی
-- ============================================

-- تابع بروزرسانی محدودیت روزانه
create or replace function update_daily_transfer_limit(
    p_user_id uuid,
    p_amount bigint
)
returns void
language plpgsql
as $$
begin
    insert into public.daily_transfer_limits (user_id, transferred_today, last_reset_date)
    values (p_user_id, p_amount, current_date)
    on conflict (user_id) do update
    set transferred_today = 
        case 
            when daily_transfer_limits.last_reset_date < current_date then p_amount
            else daily_transfer_limits.transferred_today + p_amount
        end,
        last_reset_date = 
        case 
            when daily_transfer_limits.last_reset_date < current_date then current_date
            else daily_transfer_limits.last_reset_date
        end,
        updated_at = now();
end;
$$;

-- تابع بررسی محدودیت انتقال
create or replace function check_transfer_limits(
    p_user_id uuid,
    p_amount bigint
)
returns json
language plpgsql
as $$
declare
    v_settings jsonb;
    v_min_amount bigint;
    v_max_amount bigint;
    v_daily_limit bigint;
    v_transferred_today bigint;
    v_today date;
begin
    -- دریافت تنظیمات
    select value into v_settings from public.system_settings where key = 'transfer_limits';
    
    v_min_amount := (v_settings->>'min_amount')::bigint;
    v_max_amount := (v_settings->>'max_amount')::bigint;
    v_daily_limit := (v_settings->>'daily_limit')::bigint;
    
    -- بررسی حداقل و حداکثر مبلغ
    if p_amount < v_min_amount then
        return json_build_object('allowed', false, 'reason', 'amount_below_min', 'min', v_min_amount);
    end if;
    
    if p_amount > v_max_amount then
        return json_build_object('allowed', false, 'reason', 'amount_above_max', 'max', v_max_amount);
    end if;
    
    -- بررسی سقف روزانه
    v_today := current_date;
    
    select transferred_today into v_transferred_today
    from public.daily_transfer_limits
    where user_id = p_user_id and last_reset_date = v_today;
    
    v_transferred_today := coalesce(v_transferred_today, 0);
    
    if v_transferred_today + p_amount > v_daily_limit then
        return json_build_object(
            'allowed', false, 
            'reason', 'daily_limit_exceeded',
            'remaining', v_daily_limit - v_transferred_today,
            'daily_limit', v_daily_limit
        );
    end if;
    
    return json_build_object('allowed', true);
end;
$$;
-- ============================================
-- تابع پردازش انتقال داخلی (سمت سرور)
-- این تابع به صورت اتمیک اجرا می‌شود
-- ============================================

create or replace function process_internal_transfer(
    p_from_user_id uuid,
    p_to_user_id uuid,
    p_amount bigint,
    p_description text default 'انتقال اعتبار'
)
returns json
language plpgsql
as $$
declare
    v_from_balance bigint;
    v_to_balance bigint;
    v_from_balance_after bigint;
    v_to_balance_after bigint;
    v_transaction_id uuid;
    v_limits_check json;
begin
    -- بررسی محدودیت‌های انتقال
    select check_transfer_limits(p_from_user_id, p_amount) into v_limits_check;
    
    if not (v_limits_check->>'allowed')::boolean then
        return json_build_object('success', false, 'error', v_limits_check->>'reason');
    end if;
    
    -- قفل کردن ردیف‌ها برای جلوگیری از همزمانی (Row Lock)
    select balance into v_from_balance
    from public.profiles
    where id = p_from_user_id
    for update;
    
    select balance into v_to_balance
    from public.profiles
    where id = p_to_user_id
    for update;
    
    -- بررسی موجودی کافی
    if v_from_balance < p_amount then
        return json_build_object('success', false, 'error', 'insufficient_balance');
    end if;
    
    -- محاسبه موجودی جدید
    v_from_balance_after := v_from_balance - p_amount;
    v_to_balance_after := v_to_balance + p_amount;
    
    -- بروزرسانی موجودی کاربر فرستنده
    update public.profiles
    set balance = v_from_balance_after
    where id = p_from_user_id;
    
    -- بروزرسانی موجودی کاربر گیرنده
    update public.profiles
    set balance = v_to_balance_after
    where id = p_to_user_id;
    
    -- ثبت تراکنش خروج
    insert into public.transactions (
        user_id, type, amount, balance_after, status,
        from_user_id, to_user_id, description
    ) values (
        p_from_user_id, 'transfer_out', p_amount, v_from_balance_after, 'completed',
        p_from_user_id, p_to_user_id, p_description
    );
    
    -- ثبت تراکنش ورود
    insert into public.transactions (
        user_id, type, amount, balance_after, status,
        from_user_id, to_user_id, description
    ) values (
        p_to_user_id, 'transfer_in', p_amount, v_to_balance_after, 'completed',
        p_from_user_id, p_to_user_id, p_description
    );
    
    -- ثبت در لاگ انتقالات
    insert into public.internal_transfers_log (
        from_user_id, to_user_id, amount,
        from_balance_before, from_balance_after,
        to_balance_before, to_balance_after,
        description
    ) values (
        p_from_user_id, p_to_user_id, p_amount,
        v_from_balance, v_from_balance_after,
        v_to_balance, v_to_balance_after,
        p_description
    );
    
    -- بروزرسانی محدودیت روزانه
    perform update_daily_transfer_limit(p_from_user_id, p_amount);
    
    return json_build_object(
        'success', true,
        'from_balance', v_from_balance_after,
        'to_balance', v_to_balance_after
    );
end;
$$;