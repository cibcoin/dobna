-- ============================================
-- جداول مدیریتی دوبنا
-- ============================================

-- 1. جدول درخواست‌های پشتیبانی
create table public.support_tickets (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    subject text not null,
    message text not null,
    status text default 'pending' check (status in ('pending', 'in_progress', 'resolved', 'closed')),
    admin_response text,
    resolved_by uuid references public.profiles(id),
    created_at timestamp with time zone default now(),
    resolved_at timestamp with time zone
);

-- 2. جدول لاگ برداشت‌ها (برای کارت به کارت)
create table public.withdraw_logs (
    id uuid default uuid_generate_v4() primary key,
    withdraw_request_id uuid references public.withdraw_requests(id),
    admin_id uuid references public.profiles(id),
    transaction_id text,  -- شماره پیگیری کارت به کارت
    bank_receipt text,    -- تصویر رسید
    notes text,
    created_at timestamp with time zone default now()
);

-- 3. جدول آمار روزانه کارت‌های برنده
create table public.daily_card_stats (
    id uuid default uuid_generate_v4() primary key,
    stat_date date not null,
    card_number integer not null,
    win_count integer default 0,
    win_type text check (win_type in ('line', 'full_house')),
    total_prize bigint default 0,
    created_at timestamp with time zone default now(),
    unique(stat_date, card_number, win_type)
);

-- 4. تابع بروزرسانی آمار کارت‌های برنده
create or replace function update_card_win_stats()
returns trigger
language plpgsql
as $$
begin
    insert into public.daily_card_stats (stat_date, card_number, win_type, win_count, total_prize)
    values (current_date, NEW.card_number, NEW.winner_type, 1, NEW.prize_amount)
    on conflict (stat_date, card_number, win_type) do update
    set win_count = daily_card_stats.win_count + 1,
        total_prize = daily_card_stats.total_prize + NEW.prize_amount;
    
    return NEW;
end;
$$;

-- تریگر برای بروزرسانی خودکار آمار
create trigger trigger_update_card_stats
    after insert on public.winners_history
    for each row
    execute function update_card_win_stats();

-- ============================================
-- Webhook برای ارسال خودکار رویدادها
-- ============================================

-- 1. تابع ارسال به Edge Function
create or replace function notify_admin_via_webhook()
returns trigger
language plpgsql
as $$
declare
    webhook_url text := 'https://your-project.supabase.co/functions/v1/notify-admin';
    payload json;
begin
    -- ساخت payload بر اساس نوع رویداد
    if TG_TABLE_NAME = 'withdraw_requests' then
        payload = json_build_object(
            'event', 'new_withdraw',
            'data', row_to_json(NEW),
            'timestamp', now()
        );
    elsif TG_TABLE_NAME = 'transactions' and NEW.type = 'deposit' and NEW.status = 'completed' then
        payload = json_build_object(
            'event', 'new_deposit',
            'data', row_to_json(NEW),
            'timestamp', now()
        );
    elsif TG_TABLE_NAME = 'support_tickets' then
        payload = json_build_object(
            'event', 'new_ticket',
            'data', row_to_json(NEW),
            'timestamp', now()
        );
    elsif TG_TABLE_NAME = 'winners_history' then
        payload = json_build_object(
            'event', 'new_winner',
            'data', row_to_json(NEW),
            'timestamp', now()
        );
    else
        return NEW;
    end if;
    
    -- ارسال HTTP request به Edge Function
    perform
        net.http_post(
            url := webhook_url,
            headers := jsonb_build_object('Content-Type', 'application/json'),
            body := payload::jsonb
        );
    
    return NEW;
end;
$$;

-- 2. ایجاد Triggers برای هر جدول

-- درخواست برداشت جدید
create trigger trigger_notify_withdraw
    after insert on public.withdraw_requests
    for each row
    execute function notify_admin_via_webhook();

-- واریز موفق
create trigger trigger_notify_deposit
    after insert on public.transactions
    for each row
    when (NEW.type = 'deposit' and NEW.status = 'completed')
    execute function notify_admin_via_webhook();

-- تیکت پشتیبانی جدید
create trigger trigger_notify_ticket
    after insert on public.support_tickets
    for each row
    execute function notify_admin_via_webhook();

-- برنده جدید
create trigger trigger_notify_winner
    after insert on public.winners_history
    for each row
    execute function notify_admin_via_webhook();
// سرویس مستقل برای ارسال به بله
// supabase/functions/bale-bot/index.ts
import { serve } from 'https://deno.land/std@0.168.0/http/server.ts';

const BALE_BOT_TOKEN = Deno.env.get('BALE_BOT_TOKEN') || '';
const BALE_ADMIN_ID = Deno.env.get('BALE_ADMIN_ID') || '';

serve(async (req) => {
    const { title, message } = await req.json();
    
    const response = await fetch('https://api.bale.ai/v1/bots/sendMessage', {
        method: 'POST',
        headers: {
            'Authorization': `Bearer ${BALE_BOT_TOKEN}`,
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            chat_id: BALE_ADMIN_ID,
            text: `*${title}*\n\n${message}`,
            parse_mode: 'Markdown',
        }),
    });
    
    const result = await response.json();
    return new Response(JSON.stringify(result), { status: 200 });
});

-- ============================================
-- سیستم حساب کاربری (ID Chat) دوبنا
-- ============================================

-- 1. جدول حساب‌های کاربران
create table public.user_accounts (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null unique,
    account_number text unique not null,  -- شماره حساب ۱۰ رقمی
    balance bigint default 0,             -- موجودی اصلی
    locked_balance bigint default 0,      -- موجودی قفل شده (برای گروه‌ها)
    created_at timestamp with time zone default now(),
    updated_at timestamp with time zone default now(),
    is_active boolean default true
);

-- 2. جدول مرکزی دوبنا (حساب اصلی)
create table public.central_account (
    id integer primary key default 1,
    account_number text unique not null default '1111111111',
    balance bigint default 0,
    total_commission bigint default 0,    -- کل کارمزدهای دریافتی
    total_locked bigint default 0,        -- کل مبالغ قفل شده
    updated_at timestamp with time zone default now()
);

-- 3. جدول قفل‌های گروه (برای ساخت گروه)
create table public.group_locks (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    group_id uuid references public.groups(id),
    amount bigint not null,
    lock_type text check (lock_type in ('private_group', 'public_group')),
    status text default 'locked' check (status in ('locked', 'released', 'forfeited')),
    locked_at timestamp with time zone default now(),
    released_at timestamp with time zone,
    notes text
);

-- 4. جدول تاریخچه تراکنش‌های داخلی (بین کاربران)
create table public.internal_transfers (
    id uuid default uuid_generate_v4() primary key,
    from_account text not null references public.user_accounts(account_number),
    to_account text not null references public.user_accounts(account_number),
    amount bigint not null,
    fee bigint default 0,                 -- کارمزد انتقال
    net_amount bigint not null,           -- مبلغ خالص پس از کارمزد
    description text,
    status text default 'completed',
    created_at timestamp with time zone default now(),
    reference_id text
);

-- ============================================
-- توابع تولید شماره حساب ۱۰ رقمی
-- ============================================

-- تابع تولید شماره حساب تصادفی ۱۰ رقمی
create or replace function generate_account_number()
returns text
language plpgsql
as $$
declare
    new_account text;
    exists_account boolean;
begin
    loop
        -- تولید عدد ۱۰ رقمی تصادفی (1 تا 9 برای جلوگیری از صفر ابتدایی)
        new_account := floor(random() * 9000000000 + 1000000000)::text;
        
        -- بررسی یکتایی
        select exists(select 1 from public.user_accounts where account_number = new_account) into exists_account;
        exit when not exists_account;
    end loop;
    
    return new_account;
end;
$$;

-- ============================================
-- تابع ایجاد خودکار حساب برای کاربر جدید
-- ============================================

create or replace function create_user_account()
returns trigger
language plpgsql
as $$
declare
    new_account_number text;
begin
    -- تولید شماره حساب یکتا
    new_account_number := generate_account_number();
    
    -- ایجاد حساب کاربری
    insert into public.user_accounts (user_id, account_number, balance)
    values (NEW.id, new_account_number, 0);
    
    return NEW;
end;
$$;

-- تریگر برای ایجاد حساب پس از ثبت‌نام کاربر
create trigger trigger_create_user_account
    after insert on public.profiles
    for each row
    execute function create_user_account();

-- اطمینان از وجود حساب مرکزی
insert into public.central_account (account_number, balance)
select '1111111111', 0
where not exists (select 1 from public.central_account);

-- ============================================
-- تابع انتقال اعتبار بین کاربران
-- ============================================

create or replace function transfer_credit(
    p_from_account text,
    p_to_account text,
    p_amount bigint,
    p_description text default ''
)
returns json
language plpgsql
as $$
declare
    v_from_user_id uuid;
    v_to_user_id uuid;
    v_from_balance bigint;
    v_to_balance bigint;
    v_fee bigint;
    v_net_amount bigint;
    v_transfer_id uuid;
    v_central_account text := '1111111111';
begin
    -- دریافت اطلاعات حساب مبدأ
    select user_id, balance into v_from_user_id, v_from_balance
    from public.user_accounts
    where account_number = p_from_account;
    
    if not found then
        return json_build_object('success', false, 'error', 'حساب مبدأ یافت نشد');
    end if;
    
    -- دریافت اطلاعات حساب مقصد
    select user_id, balance into v_to_user_id, v_to_balance
    from public.user_accounts
    where account_number = p_to_account;
    
    if not found then
        return json_build_object('success', false, 'error', 'حساب مقصد یافت نشد');
    end if;
    
    -- بررسی حداقل و حداکثر مبلغ
    if p_amount < 10000 then
        return json_build_object('success', false, 'error', 'حداقل مبلغ انتقال ۱۰,۰۰۰ تومان است');
    end if;
    
    if p_amount > 1000000 then
        return json_build_object('success', false, 'error', 'حداکثر مبلغ انتقال ۱,۰۰۰,۰۰۰ تومان است');
    end if;
    
    -- محاسبه کارمزد (۱٪)
    v_fee := p_amount * 0.01;
    v_net_amount := p_amount - v_fee;
    
    -- بررسی موجودی کافی
    if v_from_balance < p_amount then
        return json_build_object('success', false, 'error', 'موجودی کافی نیست');
    end if;
    
    -- شروع تراکنش
    begin
        -- 1. کم کردن از حساب مبدأ
        update public.user_accounts
        set balance = balance - p_amount,
            updated_at = now()
        where account_number = p_from_account;
        
        -- 2. اضافه کردن به حساب مقصد
        update public.user_accounts
        set balance = balance + v_net_amount,
            updated_at = now()
        where account_number = p_to_account;
        
        -- 3. اضافه کردن کارمزد به حساب مرکزی
        update public.central_account
        set balance = balance + v_fee,
            total_commission = total_commission + v_fee
        where account_number = v_central_account;
        
        -- 4. ثبت تراکنش
        insert into public.internal_transfers (
            from_account, to_account, amount, fee, net_amount, description
        ) values (
            p_from_account, p_to_account, p_amount, v_fee, v_net_amount, p_description
        ) returning id into v_transfer_id;
        
        return json_build_object(
            'success', true,
            'transfer_id', v_transfer_id,
            'from_balance', v_from_balance - p_amount,
            'to_balance', v_to_balance + v_net_amount,
            'fee', v_fee,
            'net_amount', v_net_amount
        );
        
    exception when others then
        return json_build_object('success', false, 'error', 'خطا در انجام انتقال');
    end;
end;
$$;

-- ============================================
-- تابع قفل مبلغ برای ساخت گروه
-- ============================================

create or replace function lock_amount_for_group(
    p_user_id uuid,
    p_amount bigint,
    p_lock_type text,
    p_group_id uuid default null
)
returns json
language plpgsql
as $$
declare
    v_user_balance bigint;
    v_user_locked bigint;
    v_lock_id uuid;
begin
    -- دریافت موجودی کاربر
    select balance, locked_balance into v_user_balance, v_user_locked
    from public.user_accounts
    where user_id = p_user_id;
    
    if not found then
        return json_build_object('success', false, 'error', 'حساب کاربری یافت نشد');
    end if;
    
    -- بررسی موجودی قابل استفاده (موجودی - قفل شده)
    if (v_user_balance - v_user_locked) < p_amount then
        return json_build_object('success', false, 'error', 'موجودی آزاد کافی نیست');
    end if;
    
    -- بررسی نوع قفل
    if p_lock_type = 'private_group' and p_amount != 1000000 then
        return json_build_object('success', false, 'error', 'مبلغ قفل برای گروه خصوصی باید ۱,۰۰۰,۰۰۰ تومان باشد');
    end if;
    
    if p_lock_type = 'public_group' and p_amount != 10000000 then
        return json_build_object('success', false, 'error', 'مبلغ قفل برای گروه عمومی باید ۱۰,۰۰۰,۰۰۰ تومان باشد');
    end if;
    
    -- شروع تراکنش
    begin
        -- افزایش موجودی قفل شده
        update public.user_accounts
        set locked_balance = locked_balance + p_amount,
            balance = balance - p_amount,
            updated_at = now()
        where user_id = p_user_id;
        
        -- افزایش قفل در حساب مرکزی
        update public.central_account
        set total_locked = total_locked + p_amount
        where account_number = '1111111111';
        
        -- ثبت قفل
        insert into public.group_locks (
            user_id, group_id, amount, lock_type, status
        ) values (
            p_user_id, p_group_id, p_amount, p_lock_type, 'locked'
        ) returning id into v_lock_id;
        
        return json_build_object(
            'success', true,
            'lock_id', v_lock_id,
            'locked_amount', p_amount,
            'new_balance', v_user_balance - p_amount,
            'new_locked', v_user_locked + p_amount
        );
        
    exception when others then
        return json_build_object('success', false, 'error', 'خطا در قفل کردن مبلغ');
    end;
end;
$$;

-- ============================================
-- تابع آزاد کردن قفل گروه
-- ============================================

create or replace function release_group_lock(
    p_lock_id uuid,
    p_user_id uuid
)
returns json
language plpgsql
as $$
declare
    v_lock_record record;
    v_user_balance bigint;
    v_user_locked bigint;
begin
    -- دریافت اطلاعات قفل
    select * into v_lock_record
    from public.group_locks
    where id = p_lock_id and user_id = p_user_id and status = 'locked';
    
    if not found then
        return json_build_object('success', false, 'error', 'قفلی یافت نشد');
    end if;
    
    -- شروع تراکنش
    begin
        -- کاهش موجودی قفل شده و افزایش موجودی آزاد
        update public.user_accounts
        set locked_balance = locked_balance - v_lock_record.amount,
            balance = balance + v_lock_record.amount,
            updated_at = now()
        where user_id = p_user_id
        returning balance, locked_balance into v_user_balance, v_user_locked;
        
        -- کاهش قفل در حساب مرکزی
        update public.central_account
        set total_locked = total_locked - v_lock_record.amount
        where account_number = '1111111111';
        
        -- بروزرسانی وضعیت قفل
        update public.group_locks
        set status = 'released',
            released_at = now()
        where id = p_lock_id;
        
        return json_build_object(
            'success', true,
            'released_amount', v_lock_record.amount,
            'new_balance', v_user_balance,
            'new_locked', v_user_locked
        );
        
    exception when others then
        return json_build_object('success', false, 'error', 'خطا در آزاد کردن قفل');
    end;
end;
$$;
-- ============================================
-- سیستم گروه‌های بازی (جایگزین اتاق‌های عمومی)
-- ============================================

-- 1. جدول گروه‌ها (Groups)
create table public.groups (
    id uuid default uuid_generate_v4() primary key,
    name text not null,                          -- نام گروه (مثال: ایران سر بلند)
    owner_id uuid references public.profiles(id) not null,
    type text not null check (type in ('public', 'private')),
    description text,
    avatar_url text,
    
    -- آمار گروه
    total_members integer default 1,
    total_games integer default 0,
    total_wins integer default 0,
    rank_score integer default 0,                -- امتیاز رتبه‌بندی
    
    -- تنظیمات بازی
    active_room_tier integer,                    -- تالار فعال فعلی (5000,10000,...)
    active_game_id uuid,
    
    -- قفل مالی
    locked_amount bigint default 0,
    lock_id uuid,
    
    created_at timestamp with time zone default now(),
    updated_at timestamp with time zone default now(),
    is_active boolean default true
);

-- 2. جدول اعضای گروه
create table public.group_members (
    group_id uuid references public.groups(id) on delete cascade,
    user_id uuid references public.profiles(id) on delete cascade,
    role text default 'member' check (role in ('owner', 'admin', 'member')),
    joined_at timestamp with time zone default now(),
    primary key (group_id, user_id)
);

-- 3. جدول بازی‌های گروه (جایگزین active_rooms)
create table public.group_games (
    id uuid default uuid_generate_v4() primary key,
    group_id uuid references public.groups(id) on delete cascade,
    tier_id integer not null,                    -- 5000, 10000, 20000, 50000, 100000
    status text default 'waiting' check (status in ('waiting', 'active', 'finished')),
    
    -- آمار بازی
    total_cards integer default 0,               -- حداکثر 60 کارت
    total_players integer default 0,
    current_cards integer default 0,
    
    -- جوایز (بر اساس 60 کارت)
    line_prize bigint,                           -- 2 برابر قبلی
    full_house_prize bigint,                     -- 2 برابر قبلی
    
    -- برندگان
    line_winner_id uuid,
    full_house_winner_id uuid,
    
    started_at timestamp with time zone,
    finished_at timestamp with time zone,
    created_at timestamp with time zone default now()
);

-- 4. جدول کارت‌های بازی (به‌روزرسانی شده)
create table public.game_cards_new (
    id uuid default uuid_generate_v4() primary key,
    game_id uuid references public.group_games(id) on delete cascade,
    user_id uuid references public.profiles(id),
    card_number integer,                         -- 1 تا 60
    card_data integer[][],                       -- 3x9 matrix
    marked_numbers integer[] default '{}',
    line_completed boolean[] default '{false, false, false}',
    is_winner_line boolean default false,
    is_winner_full boolean default false,
    created_at timestamp with time zone default now()
);

-- 5. جدول رتبه‌بندی گروه‌ها (Leaderboard)
create table public.group_leaderboard (
    group_id uuid references public.groups(id) primary key,
    rank integer,
    score integer default 0,
    games_played integer default 0,
    total_wins integer default 0,
    updated_at timestamp with time zone default now()
);

-- ============================================
-- توابع جدید
-- ============================================

-- تابع پیدا کردن بهترین گروه برای یک تالار خاص
create or replace function find_best_group_for_tier(p_tier_id integer)
returns uuid
language plpgsql
as $$
declare
    v_group_id uuid;
begin
    -- پیدا کردن گروهی که:
    -- 1. عمومی باشد
    -- 2. تالار فعال آن با tier_id مطابقت داشته باشد
    -- 3. بازی active داشته باشد که هنوز کارت خالی داشته باشد
    -- 4. بر اساس امتیاز رتبه‌بندی مرتب شود
    select g.id into v_group_id
    from public.groups g
    join public.group_games gg on gg.group_id = g.id
    where g.type = 'public'
      and g.active_room_tier = p_tier_id
      and gg.status = 'waiting'
      and gg.current_cards < 60
    order by g.rank_score desc, gg.current_cards desc
    limit 1;
    
    return v_group_id;
end;
$$;

-- تابع شروع خودکار بازی (به محض پر شدن 60 کارت)
create or replace function auto_start_group_game()
returns trigger
language plpgsql
as $$
declare
    v_tier_record record;
    v_line_prize bigint;
    v_full_prize bigint;
begin
    -- بررسی اینکه آیا کارت‌ها به 60 رسیده است
    if NEW.current_cards >= 60 and OLD.current_cards < 60 then
        -- دریافت اطلاعات جایزه (2 برابر حالت 30 کارتی)
        select * into v_tier_record from public.room_tiers where id = NEW.tier_id;
        
        v_line_prize := (60 * v_tier_record.card_price * 9) / 100;     -- 9% از کل 60 کارت
        v_full_prize := (60 * v_tier_record.card_price * 81) / 100;    -- 81% از کل 60 کارت
        
        update public.group_games
        set status = 'active',
            line_prize = v_line_prize,
            full_house_prize = v_full_prize,
            started_at = now()
        where id = NEW.id;
        
        -- بروزرسانی گروه
        update public.groups
        set active_game_id = NEW.id,
            rank_score = rank_score + 10   -- افزایش امتیاز رتبه‌بندی
        where id = NEW.group_id;
    end if;
    
    return NEW;
end;
$$;

create trigger trigger_auto_start_group_game
    after update on public.group_games
    for each row
    execute function auto_start_group_game();




-- ============================================
-- دیتابیس کامل دوبنا (DOBNA)
-- شامل همه جداول مورد نیاز برای بازی بینگو
-- ============================================

-- ============================================
-- 1. جداول اصلی کاربران و احراز هویت
-- ============================================

-- 1.1 پروفایل کاربران (تکمیل کننده auth.users)
create table public.profiles (
    id uuid references auth.users on delete cascade primary key,
    
    -- اطلاعات پایه
    phone text unique,                          -- شماره تلفن
    email text unique,                          -- ایمیل
    username text unique not null,              -- نام کاربری (یکتا)
    display_name text,                          -- نام قابل نمایش برای همه
    full_name text,                             -- نام واقعی
    national_code text,                         -- کد ملی
    avatar_url text,                            -- آواتار کاربر
    
    -- آیدی اختصاصی دوبنا (ID Chat) - 10 رقمی
    dobna_id text unique,                       -- شماره حساب 10 رقمی منحصربفرد
    
    -- وضعیت کاربر
    is_verified boolean default false,          -- تیک آبی
    is_active boolean default true,             -- فعال/غیرفعال
    is_banned boolean default false,            -- مسدود شده توسط پشتیبانی
    ban_reason text,                            -- دلیل مسدودیت
    banned_at timestamp with time zone,         -- تاریخ مسدودیت
    
    -- کیف پول
    balance bigint default 0,                   -- موجودی کیف پول
    total_won bigint default 0,                 -- مجموع مبالغ برنده شده
    total_commission_paid bigint default 0,     -- مجموع کمیسیون‌های پرداختی
    
    -- اطلاعات بانکی
    bank_name text,                             -- نام بانک
    card_number text,                           -- شماره کارت بانکی
    shaba_number text,                          -- شماره شبا
    
    -- آمار
    total_games_played integer default 0,       -- کل بازی‌های انجام شده
    total_cards_used integer default 0,         -- کل کارت‌های استفاده شده
    invite_code text unique,                    -- کد دعوت اختصاصی
    invited_by uuid references public.profiles(id), -- دعوت شده توسط
    
    -- زمان‌ها
    created_at timestamp with time zone default now(),
    updated_at timestamp with time zone default now(),
    last_login timestamp with time zone,
    
    -- محدودیت‌ها
    check (length(dobna_id) = 10)               -- اطمینان از 10 رقمی بودن
);

-- 1.2 حساب مرکزی دوبنا
create table public.central_account (
    id integer primary key default 1,
    account_number text unique default '1111111111',
    balance bigint default 0,
    total_commission bigint default 0,
    total_locked_private_groups bigint default 0,   -- قفل گروه‌های خصوصی
    total_locked_public_groups bigint default 0,    -- قفل گروه‌های عمومی
    updated_at timestamp with time zone default now()
);

-- 1.3 حساب‌های کاربران (کیف پول اصلی)
create table public.user_accounts (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) on delete cascade unique,
    account_number text unique not null,        -- شماره حساب 10 رقمی
    balance bigint default 0,                   -- موجودی آزاد
    locked_balance bigint default 0,            -- موجودی قفل شده (برای گروه‌ها)
    created_at timestamp with time zone default now(),
    updated_at timestamp with time zone default now()
);

-- ============================================
-- 2. جداول تراکنش‌ها و مالی
-- ============================================

-- 2.1 تراکنش‌های مالی
create table public.transactions (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    type text not null check (type in (
        'deposit', 'withdraw', 'transfer_in', 'transfer_out',
        'game_entry', 'game_win_line', 'game_win_full',
        'commission_paid', 'commission_earned', 'group_lock', 'group_unlock'
    )),
    amount bigint not null,
    balance_before bigint not null,
    balance_after bigint not null,
    fee bigint default 0,
    net_amount bigint,
    description text,
    reference_id text,                          -- شماره پیگیری/ارجاع
    from_user_id uuid references public.profiles(id),
    to_user_id uuid references public.profiles(id),
    game_id uuid,
    group_id uuid,
    status text default 'pending' check (status in ('pending', 'completed', 'failed', 'cancelled')),
    
    -- فیلدهای درگاه پرداخت
    payment_authority text,
    payment_ref_id text,
    
    -- جزئیات ریز تراکنش برای هر بازی
    game_tier integer,                          -- 5000, 10000, 20000, 50000, 100000
    cards_count integer,                        -- تعداد کارت‌های خریداری شده
    cards_price_per_unit integer,               -- قیمت هر کارت
    
    created_at timestamp with time zone default now(),
    completed_at timestamp with time zone
);

-- 2.2 درخواست‌های برداشت
create table public.withdraw_requests (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    amount bigint not null,
    bank_name text not null,
    card_number text not null,
    account_holder text not null,
    shaba_number text,
    status text default 'pending' check (status in ('pending', 'processing', 'completed', 'rejected')),
    admin_note text,
    transaction_id uuid references public.transactions(id),
    processed_by uuid references public.profiles(id),
    created_at timestamp with time zone default now(),
    processed_at timestamp with time zone
);

-- 2.3 لاگ انتقالات داخلی (کاربر به کاربر)
create table public.internal_transfers_log (
    id uuid default uuid_generate_v4() primary key,
    from_user_id uuid references public.profiles(id),
    to_user_id uuid references public.profiles(id),
    from_account text,
    to_account text,
    amount bigint not null,
    fee bigint default 0,
    net_amount bigint not null,
    from_balance_before bigint,
    from_balance_after bigint,
    to_balance_before bigint,
    to_balance_after bigint,
    description text,
    created_at timestamp with time zone default now()
);

-- ============================================
-- 3. جداول گروه‌ها
-- ============================================

-- 3.1 گروه‌ها (عمومی و خصوصی)
create table public.groups (
    id uuid default uuid_generate_v4() primary key,
    name text not null,                         -- نام گروه
    username text unique,                       -- نام کاربری گروه (مانند @groupname)
    description text,                           -- توضیحات گروه
    avatar_url text,                            -- آواتار گروه
    type text not null check (type in ('public', 'private')),
    invite_link text unique,                    -- لینک دعوت گروه
    
    -- مالک گروه
    owner_id uuid references public.profiles(id) not null,
    owner_username text,
    
    -- وضعیت گروه
    is_verified boolean default false,          -- تیک آبی گروه
    is_active boolean default true,
    
    -- آمار گروه
    total_members integer default 1,
    total_games_played integer default 0,       -- کل بازی‌های انجام شده
    total_cards_used integer default 0,         -- کل کارت‌های استفاده شده
    
    -- آمار تفکیکی بر اساس تالار
    games_played_5000 integer default 0,
    games_played_10000 integer default 0,
    games_played_20000 integer default 0,
    games_played_50000 integer default 0,
    games_played_100000 integer default 0,
    
    cards_used_5000 integer default 0,
    cards_used_10000 integer default 0,
    cards_used_20000 integer default 0,
    cards_used_50000 integer default 0,
    cards_used_100000 integer default 0,
    
    commission_earned_today bigint default 0,
    commission_earned_this_month bigint default 0,
    commission_earned_this_year bigint default 0,
    total_commission_earned bigint default 0,   -- کل کمیسیون دریافتی
    
    -- مبالغ قفل شده
    locked_amount bigint default 0,
    lock_id uuid,
    
    -- امتیاز رتبه‌بندی
    rank_score integer default 0,
    
    created_at timestamp with time zone default now(),
    updated_at timestamp with time zone default now()
);

-- 3.2 اعضای گروه
create table public.group_members (
    group_id uuid references public.groups(id) on delete cascade,
    user_id uuid references public.profiles(id) on delete cascade,
    role text default 'member' check (role in ('owner', 'admin', 'member')),
    joined_at timestamp with time zone default now(),
    primary key (group_id, user_id)
);

-- 3.3 قفل‌های گروه (برای ساخت گروه)
create table public.group_locks (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    group_id uuid references public.groups(id),
    amount bigint not null,
    lock_type text check (lock_type in ('private_group', 'public_group')),
    status text default 'locked' check (status in ('locked', 'released', 'forfeited')),
    locked_at timestamp with time zone default now(),
    released_at timestamp with time zone,
    notes text
);

-- 3.4 رتبه‌بندی گروه‌ها
create table public.group_leaderboard (
    group_id uuid references public.groups(id) primary key,
    rank integer,
    score integer default 0,
    games_played integer default 0,
    total_wins integer default 0,
    updated_at timestamp with time zone default now()
);

-- ============================================
-- 4. جداول بازی
-- ============================================

-- 4.1 بازی‌های گروه
create table public.group_games (
    id uuid default uuid_generate_v4() primary key,
    group_id uuid references public.groups(id) on delete cascade,
    tier_id integer not null,                    -- 5000, 10000, 20000, 50000, 100000
    status text default 'waiting' check (status in ('waiting', 'active', 'finished', 'cancelled')),
    
    -- آمار بازی
    total_cards integer default 0,               -- حداکثر 60 کارت
    total_players integer default 0,
    current_cards integer default 0,
    
    -- اعداد اعلام شده
    called_numbers integer[] default '{}',
    current_number integer,
    
    -- جوایز (بر اساس 60 کارت)
    line_prize bigint,
    full_house_prize bigint,
    
    -- برندگان
    line_winner_id uuid references public.profiles(id),
    line_winner_name text,
    line_winner_prize bigint,
    full_house_winner_id uuid references public.profiles(id),
    full_house_winner_name text,
    full_house_winner_prize bigint,
    
    -- کمیسیون
    platform_commission bigint default 0,        -- سهم پلتفرم
    group_commission bigint default 0,           -- سهم گروه
    
    started_at timestamp with time zone,
    finished_at timestamp with time zone,
    created_at timestamp with time zone default now()
);

-- 4.2 کارت‌های بازی (60 کارت استاندارد)
create table public.game_cards (
    id uuid default uuid_generate_v4() primary key,
    game_id uuid references public.group_games(id) on delete cascade,
    user_id uuid references public.profiles(id),
    card_number integer,                         -- 1 تا 60
    card_data integer[][],                       -- آرایه 3x9 (0 برای خالی)
    marked_numbers integer[] default '{}',
    line_completed boolean[] default '{false, false, false}',
    is_winner_line boolean default false,
    is_winner_full boolean default false,
    created_at timestamp with time zone default now()
);

-- 4.3 کارت‌های استاندارد دوبنا (مرجع ثابت)
create table public.standard_cards (
    card_number integer primary key,             -- 1 تا 60
    row1 integer[] not null,                    -- 9 عدد (0 نشان‌دهنده خالی)
    row2 integer[] not null,
    row3 integer[] not null,
    created_at timestamp with time zone default now()
);

-- ============================================
-- 5. جداول چت و پیام‌ها
-- ============================================

-- 5.1 پیام‌های عمومی (سیستم به همه کاربران)
create table public.system_messages (
    id uuid default uuid_generate_v4() primary key,
    title text not null,
    message text not null,
    target text default 'all' check (target in ('all', 'specific_users', 'specific_group')),
    target_users uuid[],                         -- لیست کاربران هدف
    target_group_id uuid,
    is_read boolean default false,
    created_by uuid references public.profiles(id),
    created_at timestamp with time zone default now(),
    expires_at timestamp with time zone
);

-- 5.2 پیام‌های چت گروهی
create table public.group_chat_messages (
    id bigint generated by default as identity primary key,
    group_id uuid references public.groups(id) on delete cascade,
    user_id uuid references public.profiles(id) not null,
    message text not null check (char_length(message) <= 500),
    created_at timestamp with time zone default now()
);

-- 5.3 پیام‌های کاربر به کاربر (خصوصی)
create table public.private_messages (
    id uuid default uuid_generate_v4() primary key,
    from_user_id uuid references public.profiles(id) not null,
    to_user_id uuid references public.profiles(id) not null,
    message text not null check (char_length(message) <= 500),
    is_read boolean default false,
    created_at timestamp with time zone default now()
);

-- 5.4 پیام‌های پشتیبانی (تیکت‌ها)
create table public.support_tickets (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    subject text not null,
    message text not null,
    status text default 'pending' check (status in ('pending', 'in_progress', 'resolved', 'closed')),
    admin_response text,
    resolved_by uuid references public.profiles(id),
    created_at timestamp with time zone default now(),
    resolved_at timestamp with time zone
);

-- 5.5 پیام‌های سیستم به کاربر (اعلانات شخصی)
create table public.user_notifications (
    id uuid default uuid_generate_v4() primary key,
    user_id uuid references public.profiles(id) not null,
    title text not null,
    message text not null,
    type text check (type in ('info', 'success', 'warning', 'error')),
    is_read boolean default false,
    action_url text,
    created_at timestamp with time zone default now()
);

-- ============================================
-- 6. جداول گزارش‌ها و تخلفات
-- ============================================

-- 6.1 گزارش تخلف کاربران
create table public.reports (
    id uuid default uuid_generate_v4() primary key,
    reporter_user_id uuid references public.profiles(id) not null,  -- گزارش‌دهنده
    reported_user_id uuid references public.profiles(id) not null,  -- گزارش‌شونده
    reason text not null,
    description text,
    evidence_url text,                          -- مدرک (تصویر/فیلم)
    status text default 'pending' check (status in ('pending', 'reviewed', 'resolved', 'rejected')),
    admin_note text,
    resolved_by uuid references public.profiles(id),
    created_at timestamp with time zone default now(),
    resolved_at timestamp with time zone
);

-- 6.2 تاریخچه برندگان (برای گزارشات مالی)
create table public.winners_history (
    id uuid default uuid_generate_v4() primary key,
    game_id uuid references public.group_games(id),
    group_id uuid references public.groups(id),
    winner_type text check (winner_type in ('line', 'full_house')),
    winner_user_id uuid references public.profiles(id),
    winner_user_name text not null,
    card_number integer,
    line_index integer,
    prize_amount bigint not null,
    is_shared boolean default false,
    shared_with integer default 1,
    created_at timestamp with time zone default now()
);

-- 6.3 آمار روزانه کارت‌های برنده
create table public.daily_card_stats (
    id uuid default uuid_generate_v4() primary key,
    stat_date date not null,
    card_number integer not null,
    win_count integer default 0,
    win_type text check (win_type in ('line', 'full_house')),
    total_prize bigint default 0,
    created_at timestamp with time zone default now(),
    unique(stat_date, card_number, win_type)
);

-- ============================================
-- 7. جداول پاداش و دعوت
-- ============================================

-- 7.1 پاداش دعوت
create table public.referral_rewards (
    id uuid default uuid_generate_v4() primary key,
    referrer_id uuid references public.profiles(id) not null,   -- دعوت‌کننده
    referred_id uuid references public.profiles(id) not null,   -- دعوت‌شونده
    reward_amount bigint default 0,
    status text default 'pending' check (status in ('pending', 'paid', 'expired')),
    paid_at timestamp with time zone,
    created_at timestamp with time zone default now()
);

-- 7.2 تنظیمات سیستم (پویا)
create table public.system_settings (
    key text primary key,
    value jsonb,
    description text,
    updated_at timestamp with time zone default now()
);

-- ============================================
-- 8. ایندکس‌ها برای بهبود عملکرد
-- ============================================

-- ایندکس‌های پروفایل
create index idx_profiles_username on public.profiles(username);
create index idx_profiles_phone on public.profiles(phone);
create index idx_profiles_dobna_id on public.profiles(dobna_id);
create index idx_profiles_is_active on public.profiles(is_active);
create index idx_profiles_invite_code on public.profiles(invite_code);

-- ایندکس‌های تراکنش
create index idx_transactions_user_id on public.transactions(user_id);
create index idx_transactions_created_at on public.transactions(created_at);
create index idx_transactions_type on public.transactions(type);
create index idx_transactions_status on public.transactions(status);

-- ایندکس‌های گروه
create index idx_groups_owner_id on public.groups(owner_id);
create index idx_groups_type on public.groups(type);
create index idx_groups_rank_score on public.groups(rank_score desc);
create index idx_groups_is_active on public.groups(is_active);

-- ایندکس‌های بازی
create index idx_group_games_group_id on public.group_games(group_id);
create index idx_group_games_status on public.group_games(status);
create index idx_group_games_created_at on public.group_games(created_at desc);
create index idx_game_cards_game_id on public.game_cards(game_id);
create index idx_game_cards_user_id on public.game_cards(user_id);

-- ایندکس‌های چت
create index idx_group_chat_messages_group_id on public.group_chat_messages(group_id, created_at desc);
create index idx_private_messages_from_user on public.private_messages(from_user_id);
create index idx_private_messages_to_user on public.private_messages(to_user_id);
create index idx_support_tickets_user_id on public.support_tickets(user_id);
create index idx_support_tickets_status on public.support_tickets(status);

-- ایندکس‌های گزارش
create index idx_reports_reported_user on public.reports(reported_user_id);
create index idx_reports_status on public.reports(status);
create index idx_winners_history_created_at on public.winners_history(created_at desc);
create index idx_daily_card_stats_date on public.daily_card_stats(stat_date);

