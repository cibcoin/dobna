-- ایجاد جدول کارت‌های استاندارد (مرجع ثابت)
create table dobna_cards (
    card_number integer primary key,  -- 1 تا 60
    row1 integer[] not null,  -- 9 عدد (0 نشان‌دهنده خالی)
    row2 integer[] not null,
    row3 integer[] not null,
    created_at timestamp with time zone default now()
);

