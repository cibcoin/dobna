# 1. نصب Expo CLI (اگر ندارید)
npm install -g expo-cli

# 2. ایجاد پروژه جدید React Native با TypeScript
npx create-expo-app bingo-game --template

# انتخاب کنید: "Blank (TypeScript)"

# 3. ورود به پوشه پروژه
cd dobna-game

# 4. نصب کتابخانه‌های مورد نیاز
npm install @supabase/supabase-js @react-navigation/native @react-navigation/stack @react-navigation/bottom-tabs
npm install react-native-screens react-native-safe-area-context react-native-gesture-handler
npm install react-native-reanimated react-native-vector-icons
npm install expo-secure-store expo-image-picker
npm install react-native-svg react-native-webview
npm install zustand  # برای state management
npm install react-hook-form zod  # برای فرم‌ها

# 5. نصب dev dependencies
npm install -D @types/react-native-vector-icons tailwindcss

 https://github.com/cibcoin/dobna.git

# اجرا روی اندروید
npx expo start --android

# یا روی iOS (فقط مک)
npx expo start --ios

# یا روی وب
npx expo start --web

# برای پخش صدا در React Native
expo install expo-speech expo-av

# برای وب، نیاز به نصب خاصی نیست (از Web Speech API استفاده می‌کند)
npm install @supabase/supabase-js expo-router expo-speech expo-secure-store zustand react-native-confetti-cannon

npm install --save-dev babel-plugin-module-resolver
npx create-expo-app dobna --template

npm install --save-dev babel-plugin-module-resolver @types/react

# نصب EAS CLI
npm install -g eas-cli

# لاگین به Expo
eas login

# دپلوی API Routes
eas deploy
# نصب وابستگی‌های اضافی
npx expo install @react-native-async-storage/async-storage react-native-url-polyfill

# اجرای پروژه
npx expo start

# بعد از باز شدن صفحه، یکی از گزینه‌ها را انتخاب کنید:
# - برای اندروید: کلید 'a' را بزنید
# - برای iOS: کلید 'i' را بزنید  
# - برای وب: کلید 'w' را بزنید
# - یا با گوشی خود کد QR را اسکن کنید

# نصب کتابخانه i18n-js
npm install i18n-js

# نصب types (برای TypeScript)
npm install --save-dev @types/i18n-js


# ایجاد تگ نسخه
git tag -a v1.0.0 -m "First release - Dobna Game"
git push origin v1.0.0


# تنظیمات DNS پیشنهادی
Type    Name     Value
A       @        76.76.21.21    (Vercel IP)
CNAME   www      dobna.ir


# نصب expo-font برای مدیریت فونت
npx expo install expo-font

# برای Lottie animations
npx expo install lottie-react-native

# برای SVG
npx expo install react-native-svg

# برای صدا
npx expo install expo-av

# برای انتخاب تصویر از گالری
npx expo install expo-image-picker

# برای تبدیل base64
npm install base64-arraybuffer

# نصب گرادیانت و ناوبری
npx expo install expo-linear-gradient

# نصب برای مدیریت شماره موبایل
npx expo install expo-phone-verification

# آپدیت ایکس کد در iOS (در صورت نیاز)