# 1. نصب Expo CLI (اگر ندارید)
npm install -g expo-cli

# 2. ایجاد پروژه جدید React Native با TypeScript
npx create-expo-app bingo-game --template

# انتخاب کنید: "Blank (TypeScript)"

# 3. ورود به پوشه پروژه
cd dobna-game

# 4. نصب کتابخانه‌های مورد نیاز
npm install @supabase/supabase-js @react-navigation/native @react-navigation/stack @react-navigation/bottom-tabs
npm install react-native-screens react-native-safe-area-context react-native-gesture-handler
npm install react-native-reanimated react-native-vector-icons
npm install expo-secure-store expo-image-picker
npm install react-native-svg react-native-webview
npm install zustand  # برای state management
npm install react-hook-form zod  # برای فرم‌ها

# 5. نصب dev dependencies
npm install -D @types/react-native-vector-icons tailwindcss

 https://github.com/cibcoin/dobna.git

# اجرا روی اندروید
npx expo start --android

# یا روی iOS (فقط مک)
npx expo start --ios

# یا روی وب
npx expo start --web

# برای پخش صدا در React Native
expo install expo-speech expo-av

# برای وب، نیاز به نصب خاصی نیست (از Web Speech API استفاده می‌کند)
npm install @supabase/supabase-js expo-router expo-speech expo-secure-store zustand react-native-confetti-cannon

npm install --save-dev babel-plugin-module-resolver
npx create-expo-app dobna --template

npm install --save-dev babel-plugin-module-resolver @types/react